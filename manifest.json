{
  "manifest_version": 3,
  "name": "Multi-Site Job Saver",
  "version": "3.0",
  "description": "Save jobs from LinkedIn to your local database with filtering",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Multi-Site Job Saver"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": ["job-identity.js", "keyword-matching.js", "lifecycle-utils.js", "job-freshness.js", "site-adapters.js", "content-universal.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
